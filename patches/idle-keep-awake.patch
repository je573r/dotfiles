+    // [local] hyprland doesnt recheck inhibitors when a layer maps, only on focus/fullscreen
+    // changes etc. so after enabling we pulse a dummy inhibitor to poke it. dumb but works
+    IdleInhibitor {
+        id: recheckKicker
+        enabled: false
+        window: idleInhibitor.window
+    }
+    Timer {
+        id: kickOnTimer
+        interval: 1500
+        onTriggered: {
+            if (!root.inhibit) return;
+            recheckKicker.enabled = true;
+            kickOffTimer.restart();
+        }
+    }
+    Timer {
+        id: kickOffTimer
+        interval: 300
+        onTriggered: recheckKicker.enabled = false
+    }
+    Connections {
+        target: GlobalStates
+        function onScreenLockedChanged() {
+            if (!GlobalStates.screenLocked && root.inhibit) kickOnTimer.restart();
+        }
+    }
+
     IdleInhibitor {
         id: idleInhibitor
+        onEnabledChanged: if (enabled) kickOnTimer.restart()
         window: PanelWindow {
+            // [local] window only exists while inhibiting. hide->show forces a new surface,
